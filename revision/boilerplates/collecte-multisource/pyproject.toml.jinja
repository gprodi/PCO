[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "Collecte multi-sources, normalisation et fusion"
requires-python = ">={{ python_version }}"
dependencies = [
    "httpx>=0.28",
    "polars>=2.1",
    "rapidfuzz>=3.14",
    "beautifulsoup4>=4.15",
    "sqlalchemy>=2.0",
    "pydantic>=2.11",
    "pydantic-settings>=2.16",
    "loguru>=0.7",
]

[project.optional-dependencies]
spark = ["pyspark>=4.3"]
{%- if avec_orchestration %}
orchestration = ["prefect>=3.9"]
{%- endif %}

[dependency-groups]
dev = ["pytest>=9", "pytest-cov>=7", "ruff>=0.17"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
addopts = "--cov --cov-report=term-missing:skip-covered --cov-fail-under=80"

[tool.coverage.run]
source = ["collecte", "commun"]
branch = true

[tool.ruff]
line-length = 120

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "S", "SIM"]
ignore = ["E501"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101", "S105", "S106", "S311"]

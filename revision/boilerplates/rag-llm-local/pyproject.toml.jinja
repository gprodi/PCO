[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "RAG local et passerelle LLM sans API payante"
requires-python = ">={{ python_version }}"
dependencies = [
    "httpx>=0.28",
    "pydantic>=2.11",
    "pydantic-settings>=2.16",
    "loguru>=0.7",
    "rapidfuzz>=3.14",
]

[project.optional-dependencies]
pgvector = ["sqlalchemy>=2.0", "psycopg[binary]>=3.3", "pgvector>=0.5"]

[dependency-groups]
dev = ["pytest>=9", "pytest-cov>=7", "ruff>=0.17"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
markers = ["pgvector: nécessite APP_TEST_PGVECTOR_URL (PostgreSQL + pgvector)"]
addopts = "--cov --cov-report=term-missing:skip-covered --cov-fail-under=80"

[tool.coverage.run]
source = ["rag", "llm", "commun", "collecte"]
branch = true

[tool.ruff]
line-length = 120

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "S", "SIM"]
ignore = ["E501"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101", "S105", "S106", "S311"]

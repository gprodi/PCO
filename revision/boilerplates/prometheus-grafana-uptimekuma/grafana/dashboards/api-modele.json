{
  "uid": "api-modele",
  "title": "API du modèle",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Requêtes par seconde", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum by (route) (rate(http_requests_total[5m]))", "legendFormat": "{{route}}"}]},
    {"id": 2, "type": "stat", "title": "Taux d'erreurs 5xx", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percentunit"}},
     "targets": [{"refId": "A", "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 1e-9)"}]},
    {"id": 3, "type": "stat", "title": "Modèle en service", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "model_info", "legendFormat": "{{version}}", "instant": true}]},
    {"id": 4, "type": "timeseries", "title": "Latence p95 (s)", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}"}]},
    {"id": 5, "type": "timeseries", "title": "Confiance médiane du modèle (dérive)", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"min": 0, "max": 1}},
     "targets": [{"refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(model_prediction_confidence_bucket[30m])))"}]}
  ]
}

[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">={{ python_version }}"
dependencies = [
    "fastapi>=0.150",
    "sqlmodel>=0.0.48",
    "pydantic-settings>=2.16",
    "httpx>=0.28",
    "loguru>=0.7",
    "streamlit>=1.66",
    "uvicorn[standard]>=0.54",
]

[dependency-groups]
dev = ["pytest>=9", "ruff>=0.17"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]

[tool.ruff]
line-length = 100

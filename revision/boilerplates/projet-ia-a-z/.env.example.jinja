# Copier en .env puis remplir. Ne jamais versionner .env.
APP_DOMAINE="{{ domaine }}"

# Clé de service entre l'API d'IA et l'API de données : python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_DATA_API_KEY=
# Signature des jetons (32 caractères au moins) : python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# Développement local (docker compose fixe ses propres adresses)
APP_DATABASE_URL=sqlite:///./donnees.db
APP_AUTH_DATABASE_URL=sqlite:///./comptes.db
APP_DATA_API_URL=http://localhost:8000
APP_IA_API_URL=http://localhost:8001

# Modèles : Ollama local (ollama pull qwen3:4b && ollama pull bge-m3)
APP_OLLAMA_URL=http://localhost:11434/v1
APP_OLLAMA_MODEL=qwen3:4b
APP_OLLAMA_EMBED_MODEL=bge-m3
# Secours facultatif : clé Gemini de l'offre gratuite (https://aistudio.google.com/apikey)
APP_GEMINI_API_KEY=

# Index vectoriel : vide = en mémoire ; sinon PostgreSQL + pgvector
APP_VECTOR_URL=

# Traces Langfuse (facultatif) : clés du projet créé dans l'interface Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Mots de passe des services docker compose
POSTGRES_PASSWORD=
{%- if avec_supervision %}
GRAFANA_ADMIN_PASSWORD=
{%- endif %}

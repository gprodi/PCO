[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">={{ python_version }}"
dependencies = [
    "fastapi>=0.150",
    "uvicorn[standard]>=0.54",
    "sqlmodel>=0.0.48",
    "pydantic-settings>=2.16",
    "httpx>=0.28",
    "loguru>=0.7",
    "pyjwt>=2.15",
    "argon2-cffi>=25.1",
    "slowapi>=0.1.10",
    "python-multipart>=0.0.33",
    "prometheus-client>=0.26",
    "polars>=2.1",
    "rapidfuzz>=3.14",
    "beautifulsoup4>=4.15",
    "langgraph>=1.2.18",
    "streamlit>=1.66",
]

[project.optional-dependencies]
pgvector = ["psycopg[binary]>=3.3", "pgvector>=0.5"]
spark = ["pyspark>=4.3"]
langfuse = ["langfuse>=5.0"]
{%- if avec_orchestration %}
orchestration = ["prefect>=3.9"]
{%- endif %}

[dependency-groups]
dev = ["pytest>=9", "pytest-cov>=7", "ruff>=0.17", "pyyaml>=6"]
{%- if avec_docs %}
docs = ["sphinx>=8", "myst-parser>=4", "sphinxcontrib-mermaid>=1", "furo>=2025.9"]
{%- endif %}

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
markers = ["pgvector: nécessite APP_TEST_PGVECTOR_URL (PostgreSQL + pgvector)"]
addopts = "--cov --cov-report=term-missing:skip-covered --cov-fail-under=80"

[tool.coverage.run]
source = ["collecte", "commun", "donnees", "rag", "llm", "agents", "api_ia", "ui"]
branch = true

[tool.ruff]
line-length = 120

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "S", "SIM"]
ignore = ["E501"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101", "S105", "S106", "S311"]

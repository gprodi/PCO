// Découvre les conteneurs Docker et envoie leurs journaux à Loki.
discovery.docker "conteneurs" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "conteneurs" {
  targets = []

  // nom du service docker compose -> étiquette service_name
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
}

loki.source.docker "conteneurs" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.conteneurs.targets
  relabel_rules = discovery.relabel.conteneurs.rules
  forward_to    = [loki.process.json.receiver]
}

// Les lignes JSON de loguru : le niveau devient une étiquette (filtrage rapide).
loki.process "json" {
  stage.json {
    expressions = { level = "record.level.name" }
  }

  stage.labels {
    values = { level = "" }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

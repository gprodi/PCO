[project]
name = "{{ project_name }}"
version = "0.1.0"
requires-python = ">={{ python_version }}"
dependencies = [
    "mlflow>=3.17",
    "scikit-learn>=1.9",
    "boto3>=1.40",
    "fastapi>=0.150",
    "uvicorn[standard]>=0.54",
]

[dependency-groups]
dev = ["pytest>=9", "httpx>=0.28", "ruff>=0.17"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]

[tool.ruff]
line-length = 100

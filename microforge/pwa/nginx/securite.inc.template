# En-têtes de sécurité de la PWA (inclus dans chaque location : un add_header local masque ceux du serveur).
# connect-src : seules les deux API MicroForge sont joignables depuis la page.
# style-src-attr 'unsafe-inline' : les dessins Wokwi de l'accueil (cartes, LED) portent des attributs
# style dans leur SVG. Seuls les attributs sont permis : scripts et balises <style> restent limités au site.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ${MF_PUBLIC_API_DATA_URL} ${MF_PUBLIC_API_IA_URL}; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(self), geolocation=(), microphone=()" always;

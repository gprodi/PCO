# Copier en .env (jamais versionné). Générer les secrets avec : uv run microforge-secrets (cf. README)
MF_ENV=dev
MF_DATABASE_URL=postgresql+psycopg://microforge:microforge@postgres:5432/microforge
POSTGRES_PASSWORD=microforge

# JWT RS256 (PEM sur une ligne, \n littéraux). Laisser vides en dev : clés éphémères générées.
MF_JWT_PRIVATE_KEY=
MF_JWT_PUBLIC_KEY=
# Chiffrement Fernet des e-mails (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
MF_FERNET_KEY=
MF_BLIND_INDEX_SALT=change-me-avec-une-longue-chaine-aleatoire

MF_CORS_ORIGINS=http://localhost:8501,http://localhost:5173
MF_API_DATA_URL=http://api_data:8000
MF_API_IA_URL=http://api_ia:8001

# IA : local d'abord (Ollama tourne sur l'hôte : Mac = natif Metal, Windows = Docker GPU ou natif)
LLM_CHAIN=ollama,gemini
LLM_PROFILE=
OLLAMA_BASE_URL=http://host.docker.internal:11434
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Avec la passerelle LiteLLM (profil compose « ai ») : LLM_CHAIN=litellm
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=
LITELLM_MASTER_KEY=sk-change-me

# Vision : modèle servi par MLflow (alias) ou fichier local
MF_MLFLOW_MODEL_URI=
MF_YOLO_WEIGHTS=
MLFLOW_TRACKING_URI=http://mlflow:5000
S3_ACCESS_KEY=microforge
S3_SECRET_KEY=change-me
MLFLOW_S3_ENDPOINT_URL=http://s3:8333

# Collecte E1
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
MOUSER_API_KEY=
GITHUB_TOKEN=

# Monitoring
GRAFANA_ADMIN_PASSWORD=change-me
DISCORD_WEBHOOK_URL=

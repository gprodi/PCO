{
 "title": "MicroForge — Application (C20)",
 "uid": "mf-app",
 "schemaVersion": 39,
 "tags": [
  "microforge"
 ],
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Disponibilité des API",
   "description": "1 = en ligne",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Hors service",
         "color": "red",
         "index": 0
        },
        "1": {
         "text": "En service",
         "color": "green",
         "index": 1
        }
       }
      }
     ],
     "custom": {}
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up{job=~\"api_data|api_ia\"}",
     "legendFormat": "{{job}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Requêtes / s",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 18,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "color": {
      "mode": "palette-classic-by-name"
     },
     "custom": {}
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (job) (rate(http_requests_total[5m]))",
     "legendFormat": "{{job}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Latence p95 (s) — seuil 2 s",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "palette-classic-by-name"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 2
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "dashed"
      },
      "axisSoftMax": 2.5
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_highr_seconds_bucket[5m])))",
     "legendFormat": "{{job}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Taux d'erreurs 5xx — seuil 2 %",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "palette-classic-by-name"
     },
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.02
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "dashed"
      },
      "axisSoftMax": 0.05
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum by (job) (rate(http_requests_total{status=~\"5..\"}[5m])) or sum by (job) (rate(http_requests_total[5m])) * 0) / sum by (job) (rate(http_requests_total[5m]))",
     "legendFormat": "{{job}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Appels LLM par fournisseur",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "palette-classic-by-name"
     },
     "custom": {}
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "mf_llm_calls",
     "legendFormat": "{{kind}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  }
 ]
}

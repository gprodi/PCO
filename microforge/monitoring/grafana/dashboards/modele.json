{
 "title": "MicroForge — Modèle de vision (C11)",
 "uid": "mf-model",
 "schemaVersion": 39,
 "tags": [
  "microforge"
 ],
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Taux de corrections utilisateur — seuil 25 %",
   "description": "Part des détections modifiées ou supprimées par les utilisateurs sur 7 jours. Au-delà de 25 % : réentraînement.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "palette-classic-by-name"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.25
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "mf_detection_correction_rate",
     "legendFormat": "{{source}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Confiance moyenne (24 h) — seuil 0,5",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "palette-classic-by-name"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (source) (rate(mf_detection_confidence_sum[24h])) / sum by (source) (rate(mf_detection_confidence_count[24h]))",
     "legendFormat": "{{source}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Composants détectés / h",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "palette-classic-by-name"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (component) (rate(mf_detections_total[1h])) * 3600",
     "legendFormat": "{{component}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Objets hors catalogue / h",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "palette-classic-by-name"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (source) (rate(mf_detections_unknown_total[1h])) * 3600",
     "legendFormat": "{{source}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Durée d'analyse p95 (s)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "palette-classic-by-name"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(mf_scan_seconds_bucket[1h])))",
     "legendFormat": "{{mode}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  }
 ]
}
